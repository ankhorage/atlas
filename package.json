{
  "name": "@ankhorage/atlas",
  "bin": {
    "atlas": "dist/bin/atlas.js"
  },
  "files": [
    "dist",
    "ankh.config.json",
    ".next/BUILD_ID",
    ".next/*.js",
    ".next/*.json",
    ".next/server",
    ".next/static",
    "offline/atlas-workspace.css",
    "offline/atlas-workspace.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "paradox"
  ],
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.2.18",
    "npm": ">=10.9.2"
  },
  "version": "0.21.7",
  "description": "Analyze and visualize codebases, dependencies, architecture rules, and audit evidence.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/atlas.git"
  },
  "keywords": [
    "code-analysis",
    "dependency-graph",
    "architecture",
    "visualization",
    "static-analysis",
    "cytoscape",
    "developer-tools",
    "typescript",
    "audit",
    "codebase"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "bun run build:package && bun src/features/offline-export/adapters/outbound/bun/buildOfflineWorkspaceBundle.ts && next build",
    "build:package": "rm -rf dist && bun build --target=node --format=esm --outdir dist --root src --bundle src/capabilities/index.ts src/cli/index.ts && bun build --target=node --format=esm --outdir dist --root . --bundle bin/atlas.ts && bun x tsc -p tsconfig.package.json",
    "start": "next start",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "format:check": "ankhorage-prettier --check .",
    "format:write": "ankhorage-prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml,mjs,cjs,html,css,scss,mdx}\"",
    "test": "bun run test:unit",
    "test:unit": "testosterone",
    "test:rule-explorer": "bun test test/src/features/audit/*.spec.ts",
    "test:cov": "testosterone --coverage",
    "test:cov:html": "testosterone --coverage",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "knip:check": "ankhorage-knip",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version",
    "test:maven": "mvn -B -f maven-plugin/pom.xml test",
    "test:gradle": "gradle --no-daemon -p gradle-plugin test",
    "test:offline-browser": "bun test/e2e/offlineWorkspace.ts",
    "test:packed-offline": "bun test/e2e/packedOfflineWorkspace.ts",
    "test:compound-selection-browser": "bun test/e2e/compoundSelectionBrowser.ts",
    "test:github-logout-browser": "bun test/e2e/githubLogoutBrowser.ts",
    "test:multi-project-browser": "bun ./test/e2e/multiProjectBrowser.ts",
    "test:workspace-loading-browser": "ATLAS_FIXTURE_DIST_DIR=build-workspace-loading bunx next build test/e2e/next-fixture-app --webpack && bun ./test/e2e/workspaceLoadingBrowser.ts",
    "infra:validate": "bun src/cli/runAtlasInfraLifecycleAsync.ts validate",
    "infra:plan": "bun src/cli/runAtlasInfraLifecycleAsync.ts plan",
    "infra:generate": "bun src/cli/runAtlasInfraLifecycleAsync.ts generate",
    "infra:up": "bun src/cli/runAtlasInfraLifecycleAsync.ts up",
    "infra:status": "bun src/cli/runAtlasInfraLifecycleAsync.ts status",
    "image:build": "docker build --tag atlas-web:local .",
    "offline:bundle": "bun src/features/offline-export/adapters/outbound/bun/buildOfflineWorkspaceBundle.ts",
    "docs": "paradox",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ankhorage/ankh": "0.13.7",
    "@ankhorage/api-nextjs": "^0.2.0",
    "@ankhorage/auth": "^0.1.3",
    "@ankhorage/auth-github": "^0.2.0",
    "@ankhorage/capability": "^0.2.1",
    "@ankhorage/color-theory": "^0.3.3",
    "@ankhorage/contracts": "^25.0.0",
    "@ankhorage/dependency-graph": "1.4.0",
    "@ankhorage/graph": "^0.3.0",
    "@ankhorage/graph-cytoscape": "^0.2.0",
    "@ankhorage/infra": "^7.2.12",
    "@ankhorage/infra-local": "^0.3.28",
    "@ankhorage/infra-minikube": "^0.4.129",
    "@ankhorage/project-detector": "^0.3.3",
    "@ankhorage/repository": "^0.10.0",
    "@ankhorage/rules": "^0.5.1",
    "@ankhorage/rules-architecture": "^0.8.0",
    "@ankhorage/surface": "9.5.20",
    "@ankhorage/templates": "12.6.49",
    "@ankhorage/utility": "^1.9.85",
    "@ankhorage/zora": "27.7.1",
    "@artiphishle/testosterone": "^0.3.11",
    "ankh-hooks": "^1.5.2",
    "cytoscape": "^3.34.3",
    "next": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native-web": "~0.21.4",
    "typescript": "~6.0.3",
    "xml-js": "^1.6.11",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.9.7",
    "@ankhorage/paradox": "^0.2.28",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-native-web": "^0.19.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "playwright-core": "^1.58.2",
    "yazl": "^3.3.1"
  },
  "packageManager": "bun@1.4.2",
  "ankh": {
    "category": "atlas",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "atlas.audit",
        "owner": "@ankhorage/atlas",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Audit project architecture",
        "description": "Create an Atlas audit from a local path or GitHub repository."
      },
      {
        "id": "atlas.inspect",
        "owner": "@ankhorage/atlas",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Inspect project dependencies",
        "description": "Open the Atlas graph inspector for a local path or GitHub repository."
      },
      {
        "id": "atlas.export",
        "owner": "@ankhorage/atlas",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Export Atlas report",
        "description": "Export a portable Atlas report artifact."
      }
    ]
  },
  "knip": {
    "ignore": [
      "test/fixtures/typescript/compound-selection/support/auxiliary.ts"
    ]
  },
  "exports": {
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/atlas#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/atlas/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
