{
  "name": "@ankhorage/pkgviz",
  "bin": {
    "pkgviz": "bin/pkgviz.ts"
  },
  "files": [
    "bin",
    "src",
    "tsconfig.json",
    ".next/BUILD_ID",
    ".next/*.js",
    ".next/*.json",
    ".next/server",
    ".next/static",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "paradox"
  ],
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.2.18",
    "npm": ">=10.9.2"
  },
  "version": "0.8.3",
  "description": "Analyze and visualize codebases, dependencies, architecture rules, and audit evidence.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/pkgviz.git"
  },
  "keywords": [
    "code-analysis",
    "dependency-graph",
    "architecture",
    "visualization",
    "static-analysis",
    "cytoscape",
    "developer-tools",
    "typescript",
    "audit",
    "codebase"
  ],
  "scripts": {
    "dev": "bun run zora:materialize && next dev",
    "build": "bun run zora:materialize && next build",
    "start": "next start",
    "lint": "bun run zora:materialize && ankhorage-eslint . --max-warnings=0",
    "format:check": "ankhorage-prettier --check .",
    "format:write": "ankhorage-prettier --write \"**/*.{js,jsx,ts,tsx,json,md,yml,yaml,mjs,cjs,html,css,scss,mdx}\"",
    "test": "testosterone && bun run test:maven && bun run test:gradle",
    "test:cov": "c8 --reporter=text --reporter=text-summary tsx --test",
    "test:cov:html": "c8 --report-dir=./test/coverage --reporter=html tsx --test",
    "lint:fix": "bun run zora:materialize && ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "knip:check": "bun run zora:materialize && ankhorage-knip",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version",
    "test:maven": "mvn -B -f maven-plugin/pom.xml test",
    "test:gradle": "gradle --no-daemon -p gradle-plugin test",
    "zora:materialize": "bunx @ankhorage/ankh@0.10.84 zora sync --web",
    "docs": "paradox",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ankhorage/dependency-graph": "^1.1.1",
    "@ankhorage/graph": "^0.3.0",
    "@ankhorage/graph-cytoscape": "^0.2.0",
    "@ankhorage/project-detector": "^0.3.3",
    "@ankhorage/repository": "^0.5.1",
    "@ankhorage/rules": "^0.2.0",
    "@ankhorage/rules-architecture": "^0.5.0",
    "@ankhorage/utility": "^1.9.83",
    "@artiphishle/testosterone": "^0.3.9",
    "ankh-hooks": "^1.5.2",
    "cytoscape": "^3.34.3",
    "next": "latest",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.21.3",
    "@ankhorage/paradox": "^0.2.27",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "c8": "^10.1.3",
    "tsx": "^4.23.15"
  },
  "packageManager": "bun@1.4.2",
  "ankh": {
    "category": "pkgviz",
    "provider": "./src/cli/index.ts",
    "capabilities": [
      "pkgviz.audit",
      "pkgviz.view",
      "pkgviz.export"
    ]
  },
  "exports": {
    "./cli": "./src/cli/index.ts",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/pkgviz#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/pkgviz/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
